# Copy to .env and fill in. Never commit .env.
#
# Provider is chosen per role, entirely from here - no Python change is needed.
# Supported: openai (official API), openrouter, gemini, anthropic.
GENERATION_PROVIDER=openai
JUDGE_PROVIDER=openai
LABEL_PROVIDER=openai

# Only the key for the selected provider(s) is required.
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

GENERATION_MODEL=gpt-5.6-luna
JUDGE_MODEL=gpt-5.6-luna
# LABEL_MODEL=gpt-5.6-luna    # only needed by scripts/label_training_data.py

# Leaving the three *_MODEL values blank falls back to the provider's defaults:
#   openai    gpt-5.6-luna for all three roles
#   gemini    gemini-3.8-flash / gemini-3.7-flash / gemini-3.5-flash-lite
#   anthropic claude-opus-5 / claude-sonnet-5 / claude-haiku-4-5
#   openrouter  no defaults - its catalogue changes, so ids must be named explicitly
